# Supabase project settings (safe for the browser: anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only: never prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google SMTP: use a Google App Password, never your normal account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM=Pitlane <your-address@gmail.com>

# Telegram bot settings; configure chat access separately with BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Random high-entropy secret used only by the Vercel cron endpoint
CRON_SECRET=replace-with-a-long-random-secret